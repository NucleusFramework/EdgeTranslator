#!/usr/bin/env bash

set -euo pipefail

REPO="NucleusFramework/EdgeTranslator"
API_URL="https://api.github.com/repos/${REPO}/releases/latest"
PKG_NAME="edgetranslator"

# Only .deb packages are published. Detect a Debian-family system first.
if [ -f /etc/os-release ]; then
  if ! grep -qiE "debian|ubuntu|mint|pop|elementary|zorin|kali|mx linux|lmde" /etc/os-release; then
    if ! command -v dpkg >/dev/null 2>&1; then
      echo "Edge Translator ships a .deb. Install it from GitHub Releases on this distribution:"
      echo "  https://github.com/${REPO}/releases/latest"
      exit 1
    fi
  fi
elif ! command -v dpkg >/dev/null 2>&1; then
  echo "Could not detect a Debian-based system (dpkg missing)."
  exit 1
fi

arch="$(uname -m)"
case "$arch" in
  x86_64)           deb_arch="amd64" ;;
  aarch64|arm64)    deb_arch="arm64" ;;
  *)
    echo "Unsupported CPU architecture: ${arch}"
    exit 1
    ;;
esac

echo "Detected Debian package for architecture: ${deb_arch}"

echo "Querying latest release metadata from GitHub..."
release_json="$(curl -fsSL "${API_URL}")"

echo "Looking for .deb asset for architecture: ${deb_arch}..."
asset_url="$(printf '%s\n' "${release_json}" \
  | grep -Eo "https://github\.com/${REPO}/releases/download/[^\"]+" \
  | grep -E -- "-linux-${deb_arch}\\.deb$" \
  | head -n 1 || true)"

if [ -z "${asset_url}" ]; then
  echo "Could not find a .deb asset for ${deb_arch} in the latest release."
  exit 1
fi

tmpdir="$(mktemp -d -t edgetranslator-pkg.XXXXXX)"
tmpfile="${tmpdir}/edgetranslator.deb"

cleanup() {
  rm -rf "${tmpdir}"
}
trap cleanup EXIT

echo "Downloading: ${asset_url}"
curl -fL --progress-bar -o "${tmpfile}" "${asset_url}"

if dpkg -s "${PKG_NAME}" >/dev/null 2>&1; then
  echo "Removing previous version of ${PKG_NAME}..."
  sudo dpkg -r "${PKG_NAME}" || true
fi

echo "Installing .deb package (sudo dpkg -i)..."
sudo dpkg -i "${tmpfile}" || {
  echo "dpkg reported errors; attempting to fix dependencies with apt-get."
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get install -f
  fi
}

echo "Installation complete."

echo "Launching ${PKG_NAME}..."
launch_cmd=""
if [ -x "/opt/${PKG_NAME}/bin/${PKG_NAME}" ]; then
  launch_cmd="/opt/${PKG_NAME}/bin/${PKG_NAME}"
elif [ -x "/opt/${PKG_NAME}/bin/EdgeTranslator" ]; then
  launch_cmd="/opt/${PKG_NAME}/bin/EdgeTranslator"
elif command -v "${PKG_NAME}" >/dev/null 2>&1; then
  launch_cmd="${PKG_NAME}"
elif command -v EdgeTranslator >/dev/null 2>&1; then
  launch_cmd="EdgeTranslator"
fi

if [ -n "${launch_cmd}" ]; then
  setsid "${launch_cmd}" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
elif command -v gtk-launch >/dev/null 2>&1; then
  gtk-launch "${PKG_NAME}" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
else
  echo "Could not locate the ${PKG_NAME} launcher; please start it from your applications menu."
fi
