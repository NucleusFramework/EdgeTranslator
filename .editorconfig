root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{**/generated/**,**/build/**}]
ktlint = disabled

[*.{kt,kts}]
indent_size = 4
indent_style = space
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_filename = disabled
max_line_length = 140

# compose-rules (https://mrmans0n.github.io/compose-rules)
compose_allowed_composition_locals = LocalHostHasTitleBar,LocalWindowDrag,LocalSystemMeters,LocalThemeIsDark
compose_check_modifiers_for_visibility = only_public
